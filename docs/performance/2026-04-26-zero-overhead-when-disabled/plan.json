  "commands": {
    "bench-ci": "zig build bench-ci",
    "bench-micro": "zig build bench-micro",
    "bench-integration": "zig build bench-integration",
    "bench-ab": "bash scripts/bench_ab_runner.sh --ref-a 4de1b11 --ref-b HEAD",
    "bench-compare": "zig build bench-compare -- --baseline docs/performance/2026-04-26-zero-overhead-when-disabled/results/ref-a.json --current docs/performance/2026-04-26-zero-overhead-when-disabled/results/ref-b.json --floor 3.0",
    "bench-smoke": "zig build bench-smoke"
  },

  "ab_protocol": {
    "ref_a": "4de1b11",
    "ref_b": "HEAD",
    "warmups": 3,
    "rounds": 20,
    "stress_multiplier": 20,
    "variance_gate_multiplier": 3.0,
    "fixed_floor_pct": 3.0,
    "target_gain_pct": 5.0,
    "max_regression_pct": -3.0,
    "hard_criteria": [
      {
        "scenario_id": "comptime-disabled",
        "vs": "baseline-no-call",
        "rule": "abs(ns_per_op_median_comptime_disabled - ns_per_op_median_baseline_no_call) <= 2 AND alloc_count_comptime_disabled == 0",
        "gate_ci": true
      },
      {
        "scenario_id": "noop-tracer-startend",
        "vs": "baseline-no-call",
        "rule": "abs(ns_per_op_median_noop_tracer_startend - ns_per_op_median_baseline_no_call) <= 5 AND alloc_count_noop_tracer_startend == 0",
        "gate_ci": false,
        "note": "Advisory hard criterion; failure triggers a warning, not a CI block, in this first round."
      },
      {
        "scenario_id": "level-1-tracer-noop",
        "vs": "level-0-disabled",
        "rule": "abs(ns_per_op_median_level1 - ns_per_op_median_level0) <= 5 AND alloc_count_level1 == 0",
        "gate_ci": false,
        "note": "Advisory; same logic as noop-tracer-startend."
      }
    ],
    "optimize_mode": "ReleaseFast",
    "cpu_pin_advisory": "taskset -c 0",
    "async_workers": 0,
    "async_workers_note": "async_workers > 0 scenarios deferred pending V-4 fix (batchForceFlush 200us busy-poll in src/sdk/export.zig:406)"
  },

  "build_step_graph": {
    "bench-ci": {
      "depends_on": ["bench-micro", "bench-integration", "bench-compare", "hard_criterion_check"],
      "stdout_summary_format": "BENCH {date} {git_sha_short} micro={N}pass integ={N}pass compare={N}pass/{M}total hard_criterion=PASS|FAIL"
    },
    "bench-micro": {
      "artifact": "bench_micro_exe",
      "source": "benchmarks/micro/main.zig",
      "imports": ["otel", "framework", "build_options"],
      "build_options_required": ["otel_disabled=false"],
      "output": "docs/performance/2026-04-26-zero-overhead-when-disabled/results/micro.json"
    },
    "bench-integration": {
      "artifact": "bench_integration_exe",
      "source": "benchmarks/integration/main.zig",
      "imports": ["otel", "framework", "build_options"],
      "build_options_required": ["otel_disabled=false"],
      "output": "docs/performance/2026-04-26-zero-overhead-when-disabled/results/integ.json"
    },
    "bench-ab": {
      "description": "Shell script builds two variants and runs both. Variant A: zig build bench-ab-default -Dotel_disabled=false. Variant B: zig build bench-ab-disabled -Dotel_disabled=true.",
      "artifacts": ["bench_ab_exe_default", "bench_ab_exe_disabled"],
      "source": "benchmarks/compare.zig",
      "script": "scripts/bench_ab_runner.sh",
      "output_a": "docs/performance/2026-04-26-zero-overhead-when-disabled/results/ref-a.json",
      "output_b": "docs/performance/2026-04-26-zero-overhead-when-disabled/results/ref-b.json"
    },
    "bench-compare": {
      "artifact": "compare_bench_exe",
      "source": "benchmarks/compare.zig",
      "cli_args": "--baseline {ref_a_json} --current {ref_b_json} --floor 3.0",
      "exits_nonzero_on_regression": true
    },
    "bench-smoke": {
      "artifact": "bench_smoke_exe",
      "source": "benchmarks/smoke.zig",
      "warmups": 1,
      "rounds": 1,
      "platform_gate": "allow_failure=true on macOS",
      "note": "level-6-full-otlp-http-loopback may be excluded (Decision D-4)"
    },
    "hard_criterion_check": {
      "description": "Reads ref-a.json and ref-b.json; applies hard criterion rules for comptime-disabled. Exits non-zero if rule fails.",
      "source": "benchmarks/check_hard_criteria.zig",
      "inputs": ["results/ref-a.json", "results/ref-b.json"],
      "rules": "see ab_protocol.hard_criteria"
    },
    "V1_stub_replacement_note": "The existing bench/bench-micro/scale-bench/compare-bench stubs in build.zig (currently aliased to fmt-check) must be replaced with addRunArtifact wiring against the actual executables above. scale-bench becomes an alias for bench-ci for CI catalog compatibility."
  },

