  "cross_platform": {
    "linux_x86_64": {
      "required": true,
      "all_scenarios": true,
      "cpu_pin": "taskset -c 0 (advisory)"
    },
    "macos": {
      "required": false,
      "allow_failure": true,
      "scenarios": "bench-smoke only (1 warmup, 1 sample per comparison scenario)",
      "alloc_assertion_enforced": false,
      "note": "Validates compile correctness and Darwin clock path. alloc_count==0 assertion not enforced on macOS."
