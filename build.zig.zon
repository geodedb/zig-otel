.{
    .name = .otel,
    .version = "0.1.0",
    .fingerprint = 0x4d774a5496f74b07,
    .minimum_zig_version = "0.16.0",
    // Initial delivery is hermetic: stdlib + in-repo implementations only.
    // See docs/DEPENDENCIES.md for the seams where DevNW packages slot in
    // and the rationale for each substitution. To enable a DevNW dep, add
    // it here with a pinned commit SHA and hash, and flip the corresponding
    // build option (e.g. -Dotel_use_devnw_slog=true) in build.zig.
    .dependencies = .{
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog#65e0792d4140a736fb1e04a7b1ee84c9333d58a9",
            .hash = "slog-0.1.0-SamEDyVLBgDLhCULhAYXGTkLtFFch_zMfAj8MRz2E3Cb",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "Makefile",
        ".gitlab-ci.yml",
        "src",
        "test",
        "tests",
        "examples",
        "tools",
        "benchmarks",
        "docs",
        "scripts",
        "third_party",
        "LICENSE",
        "NOTICE",
        "README.md",
    },
}
